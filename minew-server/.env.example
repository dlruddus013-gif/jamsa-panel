PORT=3000
# DB_TYPE=sqlite | postgres
DB_TYPE=sqlite
# SQLite는 비워두면 ./data/minew.sqlite 사용
# Postgres 예: postgres://user:pass@localhost:5432/minew
DATABASE_URL=

# RSSI 임계값 (dBm)
RSSI_NEAR=-40
RSSI_NORMAL=-70
RSSI_WEAK=-85

# 비콘 오프라인 판정 (분)
BEACON_OFFLINE_MINUTES=5

# 중복 판정 시간 윈도우 (ms) — seq 없는 경우
DUPLICATE_WINDOW_MS=1000
